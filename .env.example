# Required: Google Gemini API key (powers the AI scraper & data engine).
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Set to "production" when running the built server (serves dist/ instead of Vite dev middleware).
NODE_ENV="production"

# Optional: public URL of the deployed app (not used by the app yet; reserved for future OAuth/callbacks).
APP_URL="https://your-app-url.example.com"
